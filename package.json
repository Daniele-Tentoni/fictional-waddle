{
    "name": "@daniele-tentoni/design-system",
    "version": "0.3.2",
    "description": "Design System implemented in Vue.js",
    "type": "module",
    "main": "./dist/design-system-vue.umd.js",
    "module": "./dist/design-system-vue.es.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/design-system-vue.es.js",
            "require": "./dist/design-system-vue.umd.js",
            "types": "./dist/index.d.ts"
        },
        "./style.css": "./dist/style.css",
        "./variables.css": "./dist/variables.css"
    },
    "files": [
        "dist"
    ],
    "sideEffects": [
        "**/*.css"
    ],
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "typecheck": "vue-tsc --noEmit",
        "build:tokens": "style-dictionary build -c style-dictionary.config.json",
        "build:css": "tailwindcss -i ./src/styles/tailwind.css -o ./dist/style.css --minify",
        "build:lib": "vite build",
        "build": "run-s typecheck build:tokens build:css build:lib",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "changeset": "changeset",
        "version": "changeset version",
        "release": "run-s build version publish",
        "test:unit": "vitest run"
    },
    "peerDependencies": {
        "@tanstack/vue-table": "^8.21.3",
        "vue": "^3.5.0"
    },
    "devDependencies": {
        "@changesets/cli": "^2.31.0",
        "@testing-library/vue": "^8.1.0",
        "@types/node": "^25.6.0",
        "@vitejs/plugin-vue": "^6.0.6",
        "autoprefixer": "^10.4.0",
        "eslint": "^8.0.0",
        "jsdom": "^29.1.0",
        "npm-run-all": "^4.1.5",
        "postcss": "^8.4.0",
        "prettier": "^3.8.3",
        "style-dictionary": "^5.4.0",
        "tailwindcss": "^3.4.0",
        "typescript": "^6.0.3",
        "vite": "^8.0.10",
        "vite-plugin-dts": "^4.5.4",
        "vitest": "^4.1.5",
        "vue": "^3.3.0",
        "vue-tsc": "^3.2.7"
    }
}