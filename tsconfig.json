{
    "compilerOptions": {
        "target": "ES2020",

        "module": "ESNext",
        "moduleResolution": "Bundler",

        "lib": ["ES2020", "DOM", "DOM.Iterable"],

        "strict": true,

        "isolatedModules": true,
        "useDefineForClassFields": true,

        "allowJs": false,
        "checkJs": false,

        "skipLibCheck": true,

        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,

        "resolveJsonModule": true,

        "paths": {
            "@/*": ["./src/*"]
        },

        "types": ["vite/client"],

        "noEmit": true
    },

    "include": [
        "src/**/*.ts",
        "src/**/*.vue",
        "src/**/*.d.ts",
        "vite.config.ts",
        "tailwind.config.ts"
    ],

    "exclude": ["dist", "node_modules"]
}
